rules_version = '2';

// DYDTT — Firestore security rules
//
// Data model
//   users/{uid}                     (not used yet — read-only)
//   users/{uid}/tasks/{taskId}      one doc per task; deletes are tombstones (deleted: true)
//   users/{uid}/series/{seriesId}   repeating-task rules; copies live in tasks with seriesId
//   users/{uid}/devices/{deviceId}  web-push subscriptions (task 14b)
//   users/{uid}/pet/state           the cat game (one doc: the whole cat), shared by your devices
//
// Friends & Family
//   profiles/{uid}                  { name, photo, code } — any signed-in user can read one by id
//   codes/{code}                    { uid } — look someone up by their 8-character code
//   users/{to}/requests/{from}      connection request; level = what "from" lets "to" see
//   users/{uid}/outgoing/{to}       my sent requests
//   users/{owner}/viewers/{viewer}  viewer may see owner's non-private tasks:
//                                     friend → only within ±2 days of today (UTC), read-only
//                                     family → all, and may tick tasks done / not done
//
// Only the signed-in owner can read or write their own data. Everything else is denied.
// Local-only fields (e.g. syncStatus) must be stripped before upload — unknown fields are rejected.
// Every task/series write must set syncedAt = serverTimestamp(); devices pull changes by it.
// The reminder worker (task 14b) uses a service account, which bypasses these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function optional(d, key, typeOk) {
      return !(key in d) || typeOk;
    }

    // ── Friends & Family helpers ─────────────────────────────────────────
    function viewerPath(owner) {
      return /databases/$(database)/documents/users/$(owner)/viewers/$(request.auth.uid);
    }
    function isViewer(owner) {
      return request.auth != null && exists(viewerPath(owner));
    }
    function viewerLevel(owner) {
      return get(viewerPath(owner)).data.level;
    }
    function todayDay() {
      return math.floor(request.time.toMillis() / 86400000);
    }
    // Friends: ±2 days around today in UTC covers yesterday/today/tomorrow in every time zone
    function canViewTask(owner, t) {
      return isViewer(owner) && t.private == false
        && (viewerLevel(owner) == 'family' || (t.day >= todayDay() - 2 && t.day <= todayDay() + 2));
    }
    // Family may only flip done (+ timestamps) on a non-private task
    function familyTick(owner) {
      let d = request.resource.data;
      return isViewer(owner) && viewerLevel(owner) == 'family'
        && resource.data.private == false
        && d.diff(resource.data).affectedKeys().hasOnly(['done', 'updatedAt', 'syncedAt'])
        && d.done is bool && d.updatedAt is number && d.syncedAt == request.time;
    }
    // Family ticking a repeat copy that only existed on the owner's devices so far
    function familyCreate(owner, taskId) {
      let d = request.resource.data;
      let seriesPath = /databases/$(database)/documents/users/$(owner)/series/$(d.get('seriesId', '-'));
      return isViewer(owner) && viewerLevel(owner) == 'family'
        && validTask(taskId)
        && d.private == false && d.get('deleted', false) == false
        && d.get('seriesId', '') is string && d.get('seriesId', '') != ''
        && taskId == d.seriesId + '_' + d.date + '_' + string(d.slot)
        && exists(seriesPath)
        && get(seriesPath).data.private == false
        && get(seriesPath).data.title == d.title;
    }

    function validTask(taskId) {
      let d = request.resource.data;
      return taskId.size() <= 64
        && d.keys().hasOnly(['id', 'date', 'title', 'notes', 'done', 'order', 'reminderAt',
                             'remindedAt', 'priority', 'tags', 'createdAt', 'updatedAt', 'deleted',
                             'seriesId', 'slot', 'syncedAt', 'private', 'day'])
        && d.keys().hasAll(['id', 'date', 'title', 'done', 'updatedAt', 'syncedAt'])
        && d.syncedAt == request.time
        && d.id == taskId
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.title is string && d.title.size() <= 255
        && d.done is bool
        && d.updatedAt is number
        && optional(d, 'notes',      d.get('notes', '') is string && d.get('notes', '').size() <= 5000)
        && optional(d, 'order',      d.get('order', 0) is number)
        && optional(d, 'reminderAt', d.get('reminderAt', null) == null || d.get('reminderAt', null) is number)
        && optional(d, 'remindedAt', d.get('remindedAt', null) == null || d.get('remindedAt', null) is number)
        && optional(d, 'priority',   d.get('priority', null) == null || d.get('priority', null) is number)
        && optional(d, 'tags',       d.get('tags', []) is list && d.get('tags', []).size() <= 20)
        && optional(d, 'createdAt',  d.get('createdAt', 0) is number)
        && optional(d, 'deleted',    d.get('deleted', false) is bool)
        && optional(d, 'seriesId',   d.get('seriesId', '') is string && d.get('seriesId', '').size() <= 64)
        && optional(d, 'slot',       d.get('slot', 0) is int && d.get('slot', 0) >= 0 && d.get('slot', 0) < 12)
        && optional(d, 'private',    d.get('private', false) is bool)
        && optional(d, 'day',        d.get('day', 0) is int);
    }

    function validRule(r) {
      return r is map
        && r.keys().hasOnly(['freq', 'interval', 'weekdays', 'monthDay', 'times', 'startDate', 'endDate', 'count'])
        && r.keys().hasAll(['freq', 'startDate'])
        && r.freq in ['daily', 'weekly', 'interval', 'monthly']
        && r.startDate is string && r.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && optional(r, 'interval', r.get('interval', 1) is int && r.get('interval', 1) >= 1 && r.get('interval', 1) <= 365)
        && optional(r, 'weekdays', r.get('weekdays', []) is list && r.get('weekdays', []).size() <= 7)
        && optional(r, 'monthDay', r.get('monthDay', 1) is int && r.get('monthDay', 1) >= 1 && r.get('monthDay', 1) <= 31)
        && optional(r, 'times',    r.get('times', []) is list && r.get('times', []).size() <= 12)
        && optional(r, 'endDate',  r.get('endDate', null) == null
                                   || (r.get('endDate', '') is string && r.get('endDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && optional(r, 'count',    r.get('count', null) == null || (r.get('count', 1) is int && r.get('count', 1) >= 1));
    }

    function validSeries(seriesId) {
      let d = request.resource.data;
      return seriesId.size() <= 64
        && d.keys().hasOnly(['id', 'title', 'notes', 'rule', 'createdAt', 'updatedAt', 'deleted', 'syncedAt', 'private'])
        && d.keys().hasAll(['id', 'title', 'rule', 'updatedAt', 'syncedAt'])
        && d.id == seriesId
        && d.syncedAt == request.time
        && d.title is string && d.title.size() <= 255
        && d.updatedAt is number
        && validRule(d.rule)
        && optional(d, 'notes',     d.get('notes', '') is string && d.get('notes', '').size() <= 5000)
        && optional(d, 'createdAt', d.get('createdAt', 0) is number)
        && optional(d, 'deleted',   d.get('deleted', false) is bool)
        && optional(d, 'private',   d.get('private', false) is bool);
    }

    function validProfile(pid) {
      let d = request.resource.data;
      let codePath = /databases/$(database)/documents/codes/$(d.code);
      return d.keys().hasOnly(['name', 'photo', 'code', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 50
        && d.photo is string && d.photo.size() <= 140000
        && (d.photo == '' || d.photo.matches('^(https://|data:image/(jpeg|png|webp);base64,).*'))
        && d.code is string && d.code.matches('^[A-Za-z0-9]{8}$')
        && exists(codePath) && get(codePath).data.uid == pid
        && optional(d, 'updatedAt', d.get('updatedAt', 0) is number);
    }

    function validPet() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'found', 'hunger', 'fun', 'love', 'poops', 'mice', 'coins', 'treats',
                               'toys', 'poopClock', 'starveClock', 'lastTick', 'updatedAt', 'awarded', 'syncedAt'])
        && d.keys().hasAll(['found', 'hunger', 'fun', 'love', 'coins', 'treats', 'lastTick', 'updatedAt', 'syncedAt'])
        && d.syncedAt == request.time
        && d.found is bool
        && d.hunger is number && d.hunger >= 0 && d.hunger <= 100
        && d.fun is number    && d.fun >= 0    && d.fun <= 100
        && d.love is number   && d.love >= 0   && d.love <= 100
        && d.coins is int     && d.coins >= 0  && d.coins <= 9999
        && d.treats is int    && d.treats >= 0 && d.treats <= 99
        && d.lastTick is number && d.updatedAt is number
        && optional(d, 'v',           d.get('v', 0) is int)
        && optional(d, 'poops',       d.get('poops', 0) is int && d.get('poops', 0) >= 0 && d.get('poops', 0) <= 3)
        && optional(d, 'mice',        d.get('mice', 0) is int && d.get('mice', 0) >= 0 && d.get('mice', 0) <= 3)
        && optional(d, 'poopClock',   d.get('poopClock', 0) is number)
        && optional(d, 'starveClock', d.get('starveClock', 0) is number)
        && optional(d, 'toys',        d.get('toys', {}) is map && d.get('toys', {}).size() <= 5
                                      && d.get('toys', {}).keys().hasOnly(['mouse', 'ball', 'feather', 'spring', 'wand']))
        && optional(d, 'awarded',     d.get('awarded', []) is list && d.get('awarded', []).size() <= 500);
    }

    function validLevel(level) {
      return level in ['friend', 'family'];
    }

    function validDevice() {
      let d = request.resource.data;
      return d.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'platform', 'timeZone', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['endpoint', 'p256dh', 'auth'])
        && d.endpoint is string && d.endpoint.size() <= 1000 && d.endpoint.matches('^https://.+')
        && d.p256dh is string && d.p256dh.size() <= 200
        && d.auth is string && d.auth.size() <= 100
        && optional(d, 'platform',  d.get('platform', '') is string && d.get('platform', '').size() <= 100)
        && optional(d, 'timeZone',  d.get('timeZone', '') is string && d.get('timeZone', '').size() <= 64)
        && optional(d, 'createdAt', d.get('createdAt', 0) is number)
        && optional(d, 'updatedAt', d.get('updatedAt', 0) is number);
    }

    match /profiles/{pid} {
      allow get:              if request.auth != null;
      allow list:             if false;
      allow create, update:   if request.auth != null && request.auth.uid == pid && validProfile(pid);
      allow delete:           if request.auth != null && request.auth.uid == pid;
    }

    match /codes/{code} {
      allow get:              if request.auth != null;
      allow list, update:     if false;
      allow create:           if request.auth != null && code.matches('^[A-Za-z0-9]{8}$')
                                && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                                && request.resource.data.uid == request.auth.uid;
      allow delete:           if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      // No profile doc is needed yet; subcollections work without it.
      allow read:  if isOwner(uid);
      allow write: if false;

      match /tasks/{taskId} {
        allow read:   if isOwner(uid) || canViewTask(uid, resource.data);
        allow delete: if isOwner(uid);
        allow create: if (isOwner(uid) && validTask(taskId)) || familyCreate(uid, taskId);
        allow update: if (isOwner(uid) && validTask(taskId)) || familyTick(uid);
      }

      // The cat game — only you, from any of your devices
      match /pet/{petId} {
        allow read, delete:   if isOwner(uid);
        allow create, update: if isOwner(uid) && petId == 'state' && validPet();
      }

      match /series/{seriesId} {
        allow read:             if isOwner(uid) || (isViewer(uid) && resource.data.private == false);
        allow delete:           if isOwner(uid);
        allow create, update:   if isOwner(uid) && validSeries(seriesId);
      }

      // Connection requests sent TO this user
      match /requests/{from} {
        allow read, delete:     if request.auth != null && (request.auth.uid == uid || request.auth.uid == from);
        allow create, update:   if request.auth != null && request.auth.uid == from && from != uid
                                  && request.resource.data.keys().hasOnly(['from', 'level', 'createdAt'])
                                  && request.resource.data.from == from
                                  && validLevel(request.resource.data.level);
      }

      // Requests this user has sent (their own bookkeeping)
      match /outgoing/{to} {
        allow read, delete:     if isOwner(uid);
        allow create, update:   if isOwner(uid)
                                  && request.resource.data.keys().hasOnly(['to', 'level', 'createdAt'])
                                  && validLevel(request.resource.data.level);
      }

      // Who may view this user's tasks, and how much (set by this user)
      match /viewers/{viewer} {
        allow read, delete:     if isOwner(uid) || (request.auth != null && request.auth.uid == viewer);
        allow update:           if isOwner(uid)
                                  && request.resource.data.keys().hasOnly(['level', 'since'])
                                  && validLevel(request.resource.data.level);
        // The owner adds a viewer, or the viewer accepts the owner's request
        // (the owner's level choice travels in that request)
        allow create:           if request.resource.data.keys().hasOnly(['level', 'since'])
                                  && validLevel(request.resource.data.level)
                                  && (isOwner(uid)
                                      || (request.auth != null && request.auth.uid == viewer
                                          && exists(/databases/$(database)/documents/users/$(viewer)/requests/$(uid))
                                          && get(/databases/$(database)/documents/users/$(viewer)/requests/$(uid)).data.level
                                             == request.resource.data.level));
      }

      match /devices/{deviceId} {
        allow read, delete:     if isOwner(uid);
        allow create, update:   if isOwner(uid) && deviceId.size() <= 128 && validDevice();
      }
    }
  }
}
