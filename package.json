{
  "name": "dydtt-phase1",
  "version": "1.0.0",
  "description": "Do Your Daily Tasks Today \u2014 Phase 1 PWA",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "eslint src tests firestore",
    "lint:fix": "eslint src tests firestore --fix",
    "format": "prettier --write \"src/**/*.{js,css,json}\"",
    "seed": "node --experimental-vm-modules src/db/seed.js",
    "icons": "node scripts/generate-icons.mjs",
    "test:rules": "pnpm dlx firebase-tools@14 emulators:exec --only firestore --project demo-dydtt \"vitest run --config firestore/vitest.config.js\"",
    "deploy:rules": "pnpm dlx firebase-tools@14 deploy --only firestore:rules,firestore:indexes --project dydtt-c3633",
    "android": "vite build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "dexie": "^4.0.8",
    "firebase": "^12.19.0",
    "workbox-background-sync": "^7.3.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@chromatic-com/storybook": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-backgrounds": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-interactions": "^8.3.0",
    "@storybook/addon-viewport": "^8.3.0",
    "@storybook/html-vite": "^8.3.0",
    "@storybook/test": "^8.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "sharp": "^0.33.5",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@firebase/util"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "browserslist": [
    "Chrome >= 120",
    "Firefox >= 121",
    "Safari >= 17.2",
    "Edge >= 120",
    "Samsung >= 24"
  ]
}
